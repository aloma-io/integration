# J05 the content-encryption allow-list also admits A128GCM. Must fail: test/jwe-config.test.mjs "only RSA-OAEP-256 with A256GCM is accepted: another content encryption or key-management algorithm is refused"
diff --git a/integration-sdk/src/internal/util/jwe/index.mts b/integration-sdk/src/internal/util/jwe/index.mts
--- a/integration-sdk/src/internal/util/jwe/index.mts
+++ b/integration-sdk/src/internal/util/jwe/index.mts
@@ -64,7 +64,7 @@ class JWE {
       issuer: this.issuer,
       audience,
       keyManagementAlgorithms: ['RSA-OAEP-256'],
-      contentEncryptionAlgorithms: ['A256GCM'],
+      contentEncryptionAlgorithms: ['A256GCM', 'A128GCM'],
     });
 
     return payload._data;
