diff --git a/integration-sdk/src/internal/fetcher/oauth-fetcher.mts b/integration-sdk/src/internal/fetcher/oauth-fetcher.mts
--- a/integration-sdk/src/internal/fetcher/oauth-fetcher.mts
+++ b/integration-sdk/src/internal/fetcher/oauth-fetcher.mts
@@ -166,7 +166,7 @@
       if (e?.status >= 400 && e.status < 500) e.noRetry = true;
 
       // a token that was stored while this exchange ran stays valid
-      if (this.accessToken() === before) await this.invalidate(e);
+      await this.invalidate(e);
 
       throw e;
     }
