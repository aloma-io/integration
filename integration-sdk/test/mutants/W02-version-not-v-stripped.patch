# W02-version-not-v-stripped tag leading v kept. Must fail: publish-workflow.test.mjs v3.8.66 case
diff --git a/.github/workflows/publish.yml b/.github/workflows/publish.yml
index 043868b..5943ad8 100644
--- a/.github/workflows/publish.yml
+++ b/.github/workflows/publish.yml
@@ -79,7 +79,7 @@ jobs:
         working-directory: integration-sdk
         run: |
           set -e
-          VERSION="${GITHUB_REF_NAME#v}"
+          VERSION="${GITHUB_REF_NAME}"
           if ! printf '%s' "$VERSION" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$'; then
             echo "Tag '$GITHUB_REF_NAME' is not a plain x.y.z version" >&2
             exit 1
